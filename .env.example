# 复制为 .env 用于本地运行：  copy .env.example .env
#
# 优先级（同一键名出现多次时谁生效）：
#   1) 进程环境变量（Docker compose `environment:`、宝塔「环境变量」、systemd）
#   2) 本 .env 文件
# 设置 DOTENV_OVERRIDE=1 让本文件优先于进程环境（推荐只在 .env 里管理密钥）。
#
# 修改 .env 后必须重启应用（uvicorn / docker / 宝塔项目）。

DOTENV_OVERRIDE=1

# --- 本地 / 开发环境（允许弱口令）---
# Docker Compose 不再注入弱默认值；仅本地/开发才保留 ALLOW_INSECURE_ADMIN=1。
ALLOW_INSECURE_ADMIN=1
ADMIN_PASSWORD=admin123
ADMIN_SECRET=dev-only-change-me-use-long-random

# --- 生产环境示例 ---
# ALLOW_INSECURE_ADMIN=0
# ADMIN_PASSWORD=Str0ng-Passw0rd!
# ADMIN_SECRET=please-use-a-long-random-string-here
#
# 生产建议：用 PBKDF2 哈希替代明文密码（生成方式见下），仅把哈希放入 env，
# 避免 .env 中保存明文口令：
#   python -c "from admin.auth import hash_password; print(hash_password('你的密码'))"
# 将输出的一整行（pbkdf2_sha256$...）填到下面：
# ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$...

# 可选
CONVERT_CONCURRENCY=2
# MAX_UPLOAD_BYTES=52428800
# MAX_BATCH_FILES=20
# MAX_BATCH_BYTES=268435456
# UPLOAD_RETENTION_DAYS=5
# UPLOAD_FILE_DIR=
# ADMIN_SESSION_TTL=43200
# ADMIN_COOKIE_SECURE=0
# UPLOAD_CHUNK_SIZE=1048576

# 文件转换调优
# PDF_PROCESS_POOL_THRESHOLD=2097152
# JOB_DOWNLOAD_GRACE_SEC=30
# STATIC_ASSET_VERSION=

# 引擎路径（可选，默认自动探测）
# TESSERACT_CMD=
# TESSERACT_PATH=
# LIBREOFFICE_PATH=
# SOFFICE_PATH=

# 仅当反代挂在子路径时设置（如 https://example.com/toolkit/）。
# 域名根目录反代（https://tools.example.com/ -> uvicorn）时必须留空。
# ROOT_PATH=/toolkit

# --- SEO（公网部署收录用）---
# 站点公网根地址（含协议、主机，结尾不带斜杠）。用于 canonical、
# OpenGraph、sitemap.xml、robots.txt 生成绝对 URL。
# 内网/本地部署留空即可（此时页面仍能跑，但 SEO 输出降级为相对路径）。
# SITE_ORIGIN=https://tools.example.com
# OpenGraph 分享封面图路径（相对站点根，默认 /static/icons/og-cover.png）。
# OG_IMAGE_PATH=/static/icons/og-cover.png
# 是否允许搜索引擎索引（默认允许）。预发环境设 0 可全局 noindex。
# SEO_INDEXABLE=1

# 信任的反代来源，用于通过 X-Forwarded-* 取得真实客户端 IP。
# 默认为回环地址（127.0.0.1 / ::1）——对应单机宝塔/Nginx → uvicorn。
# 若反代运行在其它机器，请在此列出其 IP/主机，保证 per-IP 限流有效。
# 切勿设为 "*"（会让客户端伪造自己的 IP）。
# TRUSTED_PROXY_HOSTS=127.0.0.1,::1

# --- 异步任务 / 公开接口限流 ---
# memory = 进程内（单 uvicorn worker）。
# redis  = 跨 worker/实例共享任务元数据。需要：
#          pip install redis、REDIS_URL，且 JOB_OUTPUT_DIR 位于共享存储。
# JOBS_BACKEND=memory
# RATE_LIMIT_BACKEND=memory
#   # 公开 per-IP 接口限流后端：memory（单 worker）或 redis（多实例用 redis）。
# REDIS_URL=redis://localhost:6379/0
# JOB_OUTPUT_DIR=/var/lib/toolkit/jobs
# API_RATE_LIMIT=30
# API_RATE_WINDOW_SEC=60
# JOB_TTL_SEC=3600

# --- 文件快递（取件码分享）---
# EXPRESS_MAX_BYTES=52428800
# EXPRESS_DEFAULT_TTL_HOURS=24
# EXPRESS_MAX_TTL_HOURS=168
# EXPRESS_DIR=
